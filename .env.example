# Job Scout AI — Environment Variables Template
# Copy this file to .env and fill in real values.

# ── OpenRouter / OpenAI ──────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENAI_API_KEY=${OPENROUTER_API_KEY}
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── TursoDB ─────────────────────────────────────────────────────
TURSO_DATABASE_URL=https://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ── JWT (generate a strong random string!) ──────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret

# ── Auto-promote these emails to admin on register ───────────────
# Comma-separated list. Leave empty to manage manually via scripts/set_admin.py
ADMIN_EMAILS=teacher@example.com

# ── Optional ─────────────────────────────────────────────────────
TARGET_ROLE=Software Engineer
